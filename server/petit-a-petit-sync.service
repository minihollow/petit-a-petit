[Unit]
Description=Petit a petit - synchronisation de la progression
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=petitapetit
EnvironmentFile=/etc/petit-a-petit-sync.env
ExecStart=/usr/bin/node /opt/petit-a-petit-sync/sync-server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/petit-a-petit-sync
PrivateTmp=true

[Install]
WantedBy=multi-user.target
